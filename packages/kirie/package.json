{
  "name": "@gd-kirie/kirie",
  "version": "0.15.3",
  "private": true,
  "type": "module",
  "exports": {
    "./kirie-node": {
      "godot": "./src-godot/kirie_node.ts"
    }
  },
  "scripts": {
    "build": "pnpm run generate:godot",
    "generate:godot": "pnpm run typecheck && tstogd convert --no-check && cp src-godot/iframe_host.js addon/addons/kirie/iframe_host.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "typescript-to-gdscript": "catalog:"
  }
}
