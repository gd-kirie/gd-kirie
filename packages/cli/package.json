{
  "name": "kirie",
  "version": "0.16.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/gd-kirie/gd-kirie.git",
    "directory": "packages/cli"
  },
  "bin": {
    "kirie": "./kirie.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./plugin/core": {
      "import": "./src/plugin/core.ts"
    },
    "./plugin/webview": {
      "import": "./src/plugin/webview.ts"
    },
    "./plugin": {
      "import": "./src/plugin/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "test:run": "vitest run --no-file-parallelism --test-timeout 30000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gd-kirie/build": "workspace:*",
    "citty": "catalog:",
    "execa": "catalog:",
    "giget": "3.3.0",
    "takanawa-node": "0.9.0"
  },
  "devDependencies": {
    "@gd-kirie/kirie": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./plugin/core": {
        "types": "./dist/plugin/core.d.ts",
        "import": "./dist/plugin/core.js"
      },
      "./plugin/webview": {
        "types": "./dist/plugin/webview.d.ts",
        "import": "./dist/plugin/webview.js"
      },
      "./plugin": {
        "types": "./dist/plugin/index.d.ts",
        "import": "./dist/plugin/index.js"
      }
    }
  }
}
